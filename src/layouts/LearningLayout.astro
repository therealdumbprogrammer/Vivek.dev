---
import '../styles/learning.css';
import BaseLayout from './BaseLayout.astro';
import { lessonUrl, type Track } from '../data/learning';
interface Props { track: Track; current?: string; title: string; toc: { id: string; title: string }[]; }
const { track, current, title, toc } = Astro.props;
const groups = [...new Set(track.lessons.map(l => l.group))];
---
<BaseLayout title={`${title} — Learning — Vivek.dev`} wide>
  <a href="#reading-content" class="sr-only focus:not-sr-only focus:block focus:mb-4 focus:text-blue-700">Skip to lesson content</a>
  <div class:list={[`track-${track.slug}`, "learning-grid grid items-start gap-8 lg:grid-cols-[230px_minmax(0,1fr)]", toc.length > 0 && "xl:grid-cols-[230px_minmax(0,1fr)_160px]"]}>
    <aside class="lg:sticky lg:top-6 lg:max-h-[calc(100vh-3rem)] lg:overflow-y-auto">
      <a href="/courses" class="text-sm text-slate-500 hover:text-blue-700">← All learning</a>
      <details open class="mt-5 rounded-xl border border-slate-200 bg-white p-4">
        <summary class="cursor-pointer font-semibold text-slate-900">{track.title}</summary>
        <nav aria-label="Learning contents" class="mt-5 text-sm">
          <a href={`/courses/${track.slug}`} aria-current={!current ? 'page' : undefined} class:list={['block rounded-md px-3 py-2', !current ? 'active-lesson font-semibold' : 'text-slate-600 hover:bg-stone-100']}>Overview</a>
          {groups.map(group => <div class="mt-6"><p class="px-3 text-xs font-semibold uppercase tracking-wide text-slate-500">{group}</p><ul class="mt-2 space-y-1">{track.lessons.filter(l => l.group === group).map(lesson => <li><a href={lessonUrl(track.slug, lesson.slug)} aria-current={current === lesson.slug ? 'page' : undefined} class:list={['flex gap-3 rounded-md px-3 py-2.5', current === lesson.slug ? 'active-lesson font-semibold' : 'text-slate-600 hover:bg-stone-100']}><span class="text-slate-400">{String(track.lessons.indexOf(lesson)+1).padStart(2,'0')}</span>{lesson.title}{lesson.draft && <span class="text-[10px] uppercase">Draft</span>}</a></li>)}</ul></div>)}
        </nav>
      </details>
      <p class="mt-4 px-1 text-xs leading-5 text-slate-500">{track.lessons.some(l => l.entry) ? "Course in development" : "Sample content · UI experiment"}</p>
    </aside>
    <div id="reading-content" class="min-w-0" tabindex="-1">
      <nav aria-label="Breadcrumb" class="mb-8 flex flex-wrap gap-2 text-xs leading-6 text-slate-500"><a href="/courses" class="hover:text-blue-700">Learning</a><span aria-hidden="true">/</span><a href={`/courses/${track.slug}`} class="hover:text-blue-700">{track.title}</a>{current && <><span aria-hidden="true">/</span><span aria-current="page">{title}</span></>}</nav>
      <slot />
    </div>
    {toc.length > 0 && <nav aria-label="On this page" data-page-toc class="sticky top-6 hidden border-l border-slate-200 pl-5 text-xs xl:block"><p class="font-semibold uppercase tracking-wide text-slate-500">On this page</p><ul class="mt-4 space-y-4">{toc.map(item => <li><a class="page-toc-link text-slate-600" href={`#${item.id}`}>{item.title}</a></li>)}</ul></nav>}
  </div>
</BaseLayout>
<style>
  .learning-grid :global(a:focus-visible), summary:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .learning-grid :global(h2[id]) { scroll-margin-top: 2rem; }
  aside > details { border-top: 3px solid var(--accent); }
  .active-lesson { color: var(--accent); background: var(--tint); box-shadow: inset 3px 0 var(--accent); }
  nav[aria-label="On this page"] { border-color: var(--edge); }
  .page-toc-link { position: relative; display: block; line-height: 1.5; transition: color 150ms ease; }
  .page-toc-link:hover { color: var(--accent); }
  .page-toc-link[aria-current="location"] { color: var(--accent); font-weight: 600; }
  .page-toc-link[aria-current="location"]::before { content: ""; position: absolute; top: 0.05rem; bottom: 0.05rem; left: calc(-1.25rem - 1px); width: 3px; border-radius: 999px; background: var(--accent); }
</style>

<script>
  const setupPageToc = () => {
    const nav = document.querySelector<HTMLElement>('[data-page-toc]');
    if (!nav || nav.dataset.ready === 'true') return;

    const items = Array.from(nav.querySelectorAll<HTMLAnchorElement>('a[href^="#"]'))
      .map(link => ({ link, heading: document.getElementById(decodeURIComponent(link.hash.slice(1))) }))
      .filter((item): item is { link: HTMLAnchorElement; heading: HTMLElement } => Boolean(item.heading));

    if (items.length === 0) return;
    nav.dataset.ready = 'true';

    let activeId = '';
    let frame = 0;

    const setActive = (id: string) => {
      if (id === activeId) return;
      activeId = id;
      for (const item of items) {
        if (item.heading.id === id) item.link.setAttribute('aria-current', 'location');
        else item.link.removeAttribute('aria-current');
      }
    };

    const updateActiveSection = () => {
      frame = 0;
      const readingLine = Math.min(180, window.innerHeight * 0.25);
      let active = items[0];

      for (const item of items) {
        if (item.heading.getBoundingClientRect().top <= readingLine) active = item;
        else break;
      }

      const atPageEnd = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2;
      setActive((atPageEnd ? items.at(-1) : active)?.heading.id ?? '');
    };

    const requestUpdate = () => {
      if (!frame) frame = window.requestAnimationFrame(updateActiveSection);
    };

    for (const item of items) {
      item.link.addEventListener('click', () => setActive(item.heading.id));
    }
    window.addEventListener('scroll', requestUpdate, { passive: true });
    window.addEventListener('resize', requestUpdate);
    window.addEventListener('hashchange', requestUpdate);
    updateActiveSection();
  };

  setupPageToc();
  document.addEventListener('astro:page-load', setupPageToc);
</script>
