      <rect x="120" y="3" width="40" height="15" rx="4"/><rect x="29" y="48" width="40" height="32" rx="6"/><rect x="211" y="48" width="40" height="32" rx="6"/>
      <path d="M131 59L140 54L149 59V69L140 74L131 69ZM131 59L140 64L149 59M140 64V74"/>
