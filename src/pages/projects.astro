---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Projects — Vivek.dev" description="Tools and projects built by Vivek.dev.">
  <section class="py-6 sm:py-12">
    <div class="max-w-3xl">
      <p class="text-sm font-semibold tracking-wide text-blue-700 uppercase">Projects</p>
      <h1 class="mt-4 text-4xl font-semibold tracking-tight text-balance sm:text-5xl">Things I’ve built.</h1>
      <p class="mt-7 text-lg leading-8 text-slate-600">
        Practical tools that turn difficult engineering concepts into something easier to see and understand.
      </p>
    </div>

    <article class="mt-12 max-w-3xl overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
      <div class="border-b border-slate-200 bg-slate-950 px-6 py-8 sm:px-8">
        <div class="flex items-center gap-3 text-sm font-medium text-blue-200">
          <span class="grid h-9 w-9 place-items-center rounded-lg bg-blue-200 font-mono font-semibold text-slate-950" aria-hidden="true">Git</span>
          Interactive learning tool
        </div>
        <div class="mt-8 flex items-center gap-4" aria-hidden="true">
          <span class="h-4 w-4 rounded-full border-2 border-emerald-300 bg-slate-950"></span>
          <span class="h-0.5 w-20 bg-blue-300"></span>
          <span class="h-4 w-4 rounded-full border-2 border-blue-300 bg-slate-950"></span>
          <span class="h-0.5 w-20 bg-violet-300"></span>
          <span class="h-4 w-4 rounded-full border-2 border-violet-300 bg-slate-950"></span>
        </div>
      </div>
      <div class="p-6 sm:p-8">
        <h2 class="text-2xl font-semibold tracking-tight text-slate-950">Git Explained</h2>
        <p class="mt-4 max-w-2xl leading-7 text-slate-600">
          A visual, beginner-friendly way to understand commits, branches, merges, rebase, remotes, and Git history—one guided change at a time.
        </p>
        <a
          class="mt-7 inline-flex rounded-md bg-blue-700 px-4 py-2.5 text-sm font-medium text-white transition hover:bg-blue-800 focus-visible:ring-2 focus-visible:ring-blue-600 focus-visible:ring-offset-2"
          href="https://git-explained.pages.dev"
          target="_blank"
          rel="noopener noreferrer"
        >
          Visit Git Explained
          <span class="ml-2" aria-hidden="true">↗</span>
        </a>
      </div>
    </article>
  </section>
</BaseLayout>
