---
import '../styles/learning.css';
import { getTracks } from '../data/learning';
const tracks = await getTracks();
import BaseLayout from '../layouts/BaseLayout.astro';

const playlists = [
  {
    id: 'PLpxcSt9FGVVGN-R6obf6ICr5m4SbvwgOo',
    label: 'Hands-on Kubernetes with Spring Boot',
    url: 'https://www.youtube.com/playlist?list=PLpxcSt9FGVVGN-R6obf6ICr5m4SbvwgOo',
  },
  {
    id: 'PLpxcSt9FGVVFaGNMP2t4egMom6ziSejah',
    label: 'Master Spring / Spring Boot',
    url: 'https://www.youtube.com/playlist?list=PLpxcSt9FGVVFaGNMP2t4egMom6ziSejah',
  },
];
---

<BaseLayout title="Vivek.dev — Engineering Notes">
  <div class="home-hero grid items-center gap-10 lg:grid-cols-[1.05fr_1fr] lg:gap-14">
    <section>
      <div class="mb-5 flex items-center gap-3">
        <img src="/avatar.svg" alt="" class="h-11 w-11 rounded-full" width="44" height="44" />
        <p class="text-sm font-medium text-slate-600">Hi, I'm Vivek</p>
      </div>
      <h1 class="text-4xl font-semibold text-balance sm:text-5xl lg:text-6xl">I build Java & cloud-native systems.</h1>
      <p class="mt-5 text-base leading-7 text-slate-600 sm:text-lg sm:leading-8">15+ years building software. Sharing what I learn about Java, Kubernetes, and the systems underneath.</p>
      <div class="mt-6 flex flex-wrap items-center gap-4">
        <a class="hero-cta rounded-lg bg-[#d65c3c] px-5 py-3 text-sm font-semibold text-white hover:bg-[#b9472e] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#d65c3c]" href="/courses">Explore learning <span aria-hidden="true">↗</span></a>
        <a class="text-sm font-medium text-slate-600 underline underline-offset-4 hover:text-blue-700" href="/blog">Read articles</a>
        <a class="text-sm font-medium text-slate-600 underline underline-offset-4 hover:text-blue-700" href="https://www.youtube.com/@the_codealchemist" target="_blank" rel="noopener noreferrer">Watch videos</a>
      </div>
    </section>
    <section aria-labelledby="learning-title" class="learning-feature rounded-2xl p-6 sm:p-7">
      <div class="flex items-center justify-between gap-3"><p class="text-xs font-semibold uppercase tracking-[.18em] text-cyan-300">Learning</p><span class="rounded-full border border-white/20 px-2.5 py-1 text-[10px] font-medium text-slate-300">EARLY PREVIEW</span></div>
      <h2 id="learning-title" class="mt-4 text-3xl font-semibold tracking-tight text-white">Understand what’s underneath.</h2>
      <p class="mt-3 text-sm leading-6 text-slate-300">Start with the JVM. Connect the dots. Go deeper.</p>
      <div class="mt-6 grid gap-3">
        {tracks.map((track,i) => <a href={`/courses/${track.slug}`} class:list={['learning-preview flex items-center gap-4 rounded-xl p-4 transition focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white', `feature-${track.slug}`]}>
          <span class="grid h-10 w-10 shrink-0 place-items-center rounded-lg bg-white/15 font-mono text-lg" aria-hidden="true">{['{ }','⬡','↗'][i]}</span>
          <div class="min-w-0"><span class="text-[10px] font-semibold uppercase tracking-wider opacity-80">{track.type}</span><h3 class="mt-1 text-sm font-semibold sm:text-base">{track.title}</h3></div>
          <span class="ml-auto text-xl" aria-hidden="true">→</span>
        </a>)}
      </div>
      <a href="/courses" class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-cyan-300 underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white">Browse all learning <span aria-hidden="true">→</span></a>
      <p class="mt-2 text-xs text-slate-400">A growing course, available as it takes shape.</p>
    </section>
  </div>

  <section class="mt-16 border-t border-slate-200 pt-12 sm:mt-20 sm:pt-16">
    <div class="max-w-3xl">
      <p class="text-sm font-semibold tracking-wide text-blue-700 uppercase">Watch</p>
      <h2 class="mt-4 text-3xl font-semibold tracking-tight text-balance sm:text-4xl">Featured playlists</h2>
      <p class="mt-5 text-lg leading-8 text-slate-600">Explore videos from my YouTube channel.</p>
    </div>
    <div class="mt-10 grid gap-6 lg:grid-cols-2">
      {playlists.map((playlist) => (
        <article class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
          <div class="aspect-video bg-slate-100">
            <iframe
              class="h-full w-full"
              src={`https://www.youtube-nocookie.com/embed/videoseries?list=${playlist.id}`}
              title={playlist.label}
              loading="lazy"
              referrerpolicy="strict-origin-when-cross-origin"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              allowfullscreen
            ></iframe>
          </div>
          <div class="flex items-center justify-between gap-4 p-5">
            <h3 class="font-semibold text-slate-900">{playlist.label}</h3>
            <a class="shrink-0 text-sm font-medium text-blue-700 underline decoration-blue-300 underline-offset-4 transition hover:text-blue-900 focus-visible:ring-2 focus-visible:ring-blue-600 focus-visible:ring-offset-2" href={playlist.url} target="_blank" rel="noopener noreferrer">Open on YouTube</a>
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .learning-feature { background: linear-gradient(145deg, #17243c, #274e8b); box-shadow: 0 24px 52px -26px #17243c; }
  .feature-jvm { background: #2458cb; color: white; }
  .feature-kubernetes { background: #08796d; color: white; }
  .feature-agentic-systems { background: #f3a858; color: #38220e; }
  .learning-preview:hover { filter: brightness(1.1); }
  @media (min-width: 1024px) { .home-hero { margin-top: -2rem; } }
</style>
