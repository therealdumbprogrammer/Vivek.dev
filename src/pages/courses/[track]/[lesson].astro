---
import { render } from 'astro:content';
import LearningLayout from '../../../layouts/LearningLayout.astro';
import { getTracks, lessonUrl } from '../../../data/learning';
export async function getStaticPaths() { return (await getTracks()).flatMap(track => track.lessons.map((lesson,index) => ({params:{track:track.slug,lesson:lesson.slug},props:{track,lesson,index}}))); }
const {track,lesson,index} = Astro.props;
const previous = track.lessons[index-1];
const next = track.lessons[index+1];
const rendered = lesson.entry ? await render(lesson.entry) : undefined;
const Content = rendered?.Content;
const readingMinutes = lesson.entry ? Math.max(1, Math.ceil((lesson.entry.body ?? "").split(/\s+/).length / 210)) : 2;
const toc = lesson.placeholder ? [] : rendered ? rendered.headings.filter(h => h.depth === 2).map(h => ({id: h.slug, title: h.text})) : [{id:'mental-model',title:'The mental model'},{id:'example',title:'A small example'},{id:'try-it',title:'Think it through'},{id:'takeaway',title:'Takeaway'}];
---
<LearningLayout track={track} current={lesson.slug} title={lesson.title} toc={toc}>
  <p class="track-label text-sm font-semibold uppercase tracking-wide">{lesson.group} · Lesson {index+1} of {track.lessons.length}</p>
  <h1 class="mt-4 text-4xl font-semibold tracking-tight sm:text-5xl">{lesson.title}</h1>
  <p class="mt-6 text-lg leading-8 text-slate-600">{lesson.summary}</p>
  <p class="mt-5 text-xs text-slate-500">{lesson.placeholder ? 'Planned lesson' : lesson.entry ? `${readingMinutes} min read · ${lesson.entry.data.jdk}` : 'Sample content for layout review · 2 min read'}</p>
  {lesson.draft && <p class="mt-5 rounded-md border border-amber-200 bg-amber-50 p-3 text-sm text-amber-900">Draft for local review · Excluded from production builds</p>}
  {lesson.placeholder ? (
    <section class="mt-10 rounded-2xl border border-[#eadfd1] bg-[#fffdf9] p-7 sm:p-9">
      <p class="text-sm font-semibold uppercase tracking-wide text-[#a24a31]">Coming next</p>
      <h2 class="mt-3 text-2xl font-semibold text-slate-900">This lesson is being prepared.</h2>
      <p class="mt-4 max-w-2xl leading-7 text-slate-600">It will build on the JVM overview and explain how heap memory fits alongside thread stacks, class metadata, compiled code, and other native allocations.</p>
    </section>
  ) : <article class="prose lesson-prose mt-8">
    {Content ? <Content /> : <>
    <h2 id="mental-model">The mental model</h2>
    <div class="lesson-callout rounded-lg border-l-4 p-5">{lesson.idea}</div>
    <p>Start by naming the pieces and the boundary between them. Then follow one operation through the system. This gives you a useful starting point before adding more detail.</p>
    <h2 id="example">A small example</h2><p>A compact example gives the idea something concrete to attach to. This snippet is illustrative; it is not executed by this page.</p>
    <pre><code>{lesson.example}</code></pre>
    <h2 id="try-it">Think it through</h2><p>{lesson.exercise}</p>
    <details class="mt-5 rounded-lg border border-slate-200 bg-white p-5"><summary class="cursor-pointer font-medium text-slate-900">A prompt to guide your thinking</summary><p>Describe what changes, what stays stable, and what evidence would help you check your explanation. Keep the first sketch small.</p></details>
    <h2 id="takeaway">Takeaway</h2><p>{lesson.idea} Return to the learning map whenever you want to put this idea back in context.</p>
    </>}
  </article>}
  <nav aria-label="Lesson navigation" class="mt-12 grid gap-4 border-t border-slate-200 pt-6 sm:grid-cols-2">
    <a class="rounded-lg border border-slate-200 bg-white p-4 hover:border-blue-400" href={previous ? lessonUrl(track.slug,previous.slug) : `/courses/${track.slug}`}><span class="block text-xs text-slate-500">← {previous ? 'Previous lesson' : 'Back to overview'}</span><span class="mt-2 block text-sm font-semibold">{previous?.title ?? track.title}</span></a>
    <a class="rounded-lg border border-slate-200 bg-white p-4 text-right hover:border-blue-400" href={next ? lessonUrl(track.slug,next.slug) : '/courses'}><span class="block text-xs text-slate-500">{next ? 'Next lesson' : 'End of preview'} →</span><span class="mt-2 block text-sm font-semibold">{next?.title ?? 'Explore all learning'}</span></a>
  </nav>
</LearningLayout>

<style>
.lesson-prose :global(figure) { margin: 2rem 0; }
.lesson-prose :global(figcaption) { font-size: .875rem; line-height: 1.6; color: #64748b; margin-top: .75rem; }
.lesson-prose :global(img) { width: 100%; height: auto; }
.lesson-prose :global(pre) { font-size: .85rem; }
.lesson-prose :global(figure img) { max-width: 480px; margin-inline: auto; }
.lesson-prose :global(.lesson-check), .lesson-prose :global(.lesson-sources) { margin: 2rem 0; padding: 1.25rem; border: 1px solid #dce5ef; border-radius: 12px; background: #f4f7fc; }
.lesson-prose :global(details summary) { cursor: pointer; font-weight: 600; color: #243c65; }
.lesson-prose :global(details summary:focus-visible) { outline: 2px solid #315dcc; outline-offset: 5px; }
.lesson-prose :global(.lesson-sources) { background: transparent; font-size: .9rem; }
</style>
